{
  "name": "coding-agent-demo",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/index.ts",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "tsc --noEmit",
    "prepare": "vp config"
  },
  "dependencies": {
    "@openai/agents": "^0.0.10",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "openai": "^4.89.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
